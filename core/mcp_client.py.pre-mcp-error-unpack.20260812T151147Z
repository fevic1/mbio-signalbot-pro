"""Provider-agnostic MCP client adapter using the official MCP Python SDK.

The MCP protocol, Streamable HTTP transport, SSE transport, sessions, and
OAuth implementation are provided by ``mcp==1.29.0``. This module only maps
MBIO's registry configuration onto the official SDK interfaces.
"""

from __future__ import annotations

from contextlib import asynccontextmanager
from typing import Any, AsyncIterator, Dict, List, Tuple

import httpx

from mcp import ClientSession
from mcp.client.sse import sse_client
from mcp.client.streamable_http import streamable_http_client

from core.mcp_registry import MCPServerConfig


class MCPClientError(RuntimeError):
    """Raised for MCP transport, authentication, or protocol failures."""


def _headers(config: MCPServerConfig) -> Dict[str, str]:
    """Build standard HTTP headers from the generic MCP registry config."""
    headers = dict(config.headers or {})
    auth_type = (config.auth_type or "none").lower()

    if auth_type in {"bearer", "oauth", "oauth2", "access_token"}:
        token = config.auth_token or config.api_key
        if token:
            headers.setdefault("Authorization", f"Bearer {token}")

    elif auth_type == "api_key" and config.api_key:
        headers.setdefault(
            config.auth_header or "X-API-Key",
            config.api_key,
        )

    return headers


def _transport(config: MCPServerConfig) -> str:
    value = (config.transport or "auto").lower().replace("-", "_")

    aliases = {
        "http": "streamable_http",
        "http_stream": "streamable_http",
        "streamablehttp": "streamable_http",
        "streamable_http": "streamable_http",
        "sse": "sse",
    }

    if value in aliases:
        return aliases[value]

    if value != "auto":
        raise MCPClientError(
            f"Unsupported MCP transport: {config.transport}"
        )

    return "streamable_http"


def _classify_http_error(exc: BaseException) -> MCPClientError:
    """Normalize HTTP/auth errors without implementing MCP transport logic."""
    response = getattr(exc, "response", None)
    status = getattr(response, "status_code", None)

    text = str(exc)

    if status == 401 or any(
        marker in text.lower()
        for marker in (
            "401",
            "unauthorized",
            "missing authorization",
        )
    ):
        return MCPClientError(
            "MCP authentication required or credentials rejected"
        )

    if status == 403 or any(
        marker in text.lower()
        for marker in (
            "403",
            "forbidden",
            "not authorized",
        )
    ):
        return MCPClientError(
            "MCP credentials are not authorized"
        )

    return MCPClientError(text or repr(exc))


@asynccontextmanager
async def open_session(
    config: MCPServerConfig,
) -> AsyncIterator[ClientSession]:
    """Open a standard MCP SDK ClientSession."""
    if not config.endpoint:
        raise MCPClientError("MCP endpoint is required")

    headers = _headers(config)
    transport = _transport(config)

    try:
        async with httpx.AsyncClient(
            headers=headers,
            follow_redirects=True,
        ) as client:

            if transport == "sse":
                async with sse_client(
                    config.endpoint,
                    httpx_kwargs={"headers": headers},
                ) as (read_stream, write_stream):
                    async with ClientSession(
                        read_stream,
                        write_stream,
                    ) as session:
                        await session.initialize()
                        yield session
                return

            async with streamable_http_client(
                config.endpoint,
                http_client=client,
            ) as (
                read_stream,
                write_stream,
                _,
            ):
                async with ClientSession(
                    read_stream,
                    write_stream,
                ) as session:
                    await session.initialize()
                    yield session

    except MCPClientError:
        raise
    except Exception as exc:
        raise _classify_http_error(exc) from exc


async def detect_transport(
    config: MCPServerConfig,
) -> Tuple[str, str | None]:
    """Return configured transport or the standard default.

    The MCP SDK owns protocol negotiation. We do not implement a second
    transport probe here.
    """
    if (config.transport or "auto").lower() not in {"", "auto"}:
        return _transport(config), None

    return "streamable_http", None


async def list_tools(
    config: MCPServerConfig,
) -> List[Dict[str, Any]]:
    """Discover tools through the official MCP ClientSession."""
    async with open_session(config) as session:
        response = await session.list_tools()
        return [
            tool.model_dump(mode="json")
            for tool in response.tools
        ]


async def call_tool(
    config: MCPServerConfig,
    name: str,
    arguments: Dict[str, Any] | None = None,
) -> Dict[str, Any]:
    """Invoke an MCP tool through the official MCP ClientSession."""
    async with open_session(config) as session:
        result = await session.call_tool(
            name,
            arguments or {},
        )
        return result.model_dump(mode="json")


async def health(
    config: MCPServerConfig,
) -> Dict[str, Any]:
    """Run the standard MCP session ping."""
    try:
        async with open_session(config) as session:
            await session.send_ping()

            capabilities = session.get_server_capabilities()

            return {
                "status": "healthy",
                "transport": _transport(config),
                "capabilities": (
                    capabilities.model_dump(mode="json")
                    if capabilities
                    else {}
                ),
            }

    except MCPClientError as exc:
        message = str(exc)

        if "authentication required" in message.lower():
            return {
                "status": "auth_required",
                "transport": _transport(config),
                "error": message,
            }

        return {
            "status": "unhealthy",
            "transport": _transport(config),
            "error": message,
        }
