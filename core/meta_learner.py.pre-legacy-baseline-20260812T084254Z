"""Canonical MBIO MetaLearner.

This module upgrades the existing MBIO learner in place.

Compatibility:
- get_meta_learner()
- update(regime, strategy_name, pnl_pct)
- record_trade_outcome(strategy_name, regime, pnl_pct)
- get_weights(regime)
- choose_strategy(regime, strategies)
- get_best_strategy(regime)
- reset_regime_to_default(regime)

Learning:
- Bayesian posterior per regime / asset bucket / horizon.
- Recency decay.
- Uncertainty discounting.
- Config-driven priors.
- Config-driven weight caps.
- ChromaDB remains the canonical persistence backend.
- No order placement.
- No execution-state mutation.
"""

from __future__ import annotations

import hashlib
import json
import logging
import math
import threading
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Mapping, Optional

import chromadb
from chromadb.config import Settings

logger = logging.getLogger(__name__)

META_COLLECTION = "meta_learner_weights"
SCHEMA_VERSION = "mbio-meta-learner-v2"
COMPAT_ASSET_BUCKET = "*"
COMPAT_HORIZON = "1h"


@dataclass(frozen=True)
class LearnerContext:
    regime: str = "RANGING"
    asset_bucket: str = COMPAT_ASSET_BUCKET
    horizon: str = COMPAT_HORIZON


@dataclass(frozen=True)
class StrategyWeights:
    weights: Dict[str, float]
    uncertainty: Dict[str, float]
    effective_samples: Dict[str, float]
    reason_codes: Dict[str, str]


@dataclass(frozen=True)
class LearnerStateSnapshot:
    version: str
    posterior_count: int
    contexts: int
    updated_at: str


@dataclass
class _Posterior:
    mean: float
    variance: float
    effective_samples: float
    win_rate: float
    average_r: float
    last_update: float


def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _now_ts() -> float:
    return datetime.now(timezone.utc).timestamp()


def _safe_float(value: Any, default: float = 0.0) -> float:
    try:
        value = float(value)
        if math.isfinite(value):
            return value
    except (TypeError, ValueError):
        pass
    return default


class MetaLearner:
    """Canonical MBIO Bayesian MetaLearner.

    The old multiplicative-PnL updater is replaced rather than duplicated.
    ChromaDB remains the persistence layer.
    """

    def __init__(
        self,
        persist_dir: str = "/app/data/chroma_db",
        config_path: str = "config/strategy_config.yaml",
    ):
        self.persist_dir = persist_dir
        self.config_path = config_path
        self._lock = threading.RLock()

        self.config = self._load_learning_config()
        self.posteriors: Dict[str, _Posterior] = {}

        self.client = chromadb.PersistentClient(
            path=persist_dir,
            settings=Settings(anonymized_telemetry=False),
        )
        self.collection = self._get_or_create_collection()
        self._load_state()

        logger.info(
            "MetaLearner v2 initialized: %d posterior(s), ChromaDB=%s",
            len(self.posteriors),
            persist_dir,
        )

    # ------------------------------------------------------------------
    # Configuration
    # ------------------------------------------------------------------

    def _load_learning_config(self) -> Dict[str, Any]:
        """Read versioned meta_learner config.

        No strategy weights are hardcoded here.
        """
        try:
            import yaml

            path = Path(self.config_path)
            if not path.exists():
                logger.warning(
                    "MetaLearner config %s not found; using conservative "
                    "schema defaults only",
                    path,
                )
                return {}

            root = yaml.safe_load(path.read_text()) or {}
            cfg = root.get("meta_learner", {}) or {}
            return cfg if isinstance(cfg, dict) else {}
        except Exception as exc:
            logger.warning("Could not load MetaLearner config: %s", exc)
            return {}

    @property
    def priors(self) -> Mapping[str, float]:
        cfg = self.config.get("priors", {}) or {}
        return {
            "mean": _safe_float(cfg.get("mean"), 0.0),
            "variance": max(_safe_float(cfg.get("variance"), 1.0), 1e-9),
            "confidence": max(_safe_float(cfg.get("confidence"), 0.05), 0.0),
        }

    @property
    def uncertainty_aversion(self) -> float:
        return max(
            _safe_float(
                (self.config.get("uncertainty", {}) or {}).get("aversion"),
                1.0,
            ),
            0.0,
        )

    @property
    def min_effective_samples(self) -> float:
        return max(
            _safe_float(
                (self.config.get("uncertainty", {}) or {}).get(
                    "min_effective_samples"
                ),
                300.0,
            ),
            0.0,
        )

    @property
    def temperature(self) -> float:
        return max(
            _safe_float(
                (self.config.get("weights", {}) or {}).get("temperature"),
                0.7,
            ),
            1e-6,
        )

    @property
    def max_strategy_weight(self) -> float:
        return max(
            0.0,
            min(
                1.0,
                _safe_float(
                    (self.config.get("weights", {}) or {}).get(
                        "max_strategy_weight"
                    ),
                    0.35,
                ),
            ),
        )

    @property
    def max_llm_weight(self) -> float:
        return max(
            0.0,
            min(
                1.0,
                _safe_float(
                    (self.config.get("weights", {}) or {}).get(
                        "max_llm_weight"
                    ),
                    0.15,
                ),
            ),
        )

    @property
    def decay_enabled(self) -> bool:
        return bool(
            (self.config.get("decay", {}) or {}).get("enabled", True)
        )

    @property
    def half_life_hours(self) -> float:
        return max(
            _safe_float(
                (self.config.get("decay", {}) or {}).get(
                    "half_life_hours"
                ),
                168.0,
            ),
            1e-9,
        )

    # ------------------------------------------------------------------
    # Persistence
    # ------------------------------------------------------------------

    def _get_or_create_collection(self):
        return self.client.get_or_create_collection(
            name=META_COLLECTION,
        )

    @staticmethod
    def _key(context: LearnerContext, strategy: str) -> str:
        return json.dumps(
            {
                "regime": context.regime,
                "asset_bucket": context.asset_bucket,
                "horizon": context.horizon,
                "strategy": strategy,
            },
            sort_keys=True,
            separators=(",", ":"),
        )

    def _serialize(self, key: str, posterior: _Posterior) -> Dict[str, Any]:
        return {
            "schema_version": SCHEMA_VERSION,
            "key": key,
            "posterior": {
                "mean": posterior.mean,
                "variance": posterior.variance,
                "effective_samples": posterior.effective_samples,
                "win_rate": posterior.win_rate,
                "average_r": posterior.average_r,
                "last_update": posterior.last_update,
            },
            "updated_at": _utc_now(),
        }

    def _load_state(self) -> None:
        try:
            result = self.collection.get()
            ids = result.get("ids") or []
            metadatas = result.get("metadatas") or []

            loaded = 0

            for identifier, metadata in zip(ids, metadatas):
                if not metadata:
                    continue

                raw = metadata.get("posterior")
                key = metadata.get("key") or identifier

                if not raw:
                    # Legacy Chroma records are intentionally not treated as
                    # Bayesian posterior state. They remain readable but do
                    # not become hidden "priors".
                    continue

                try:
                    posterior = json.loads(raw)
                    self.posteriors[key] = _Posterior(
                        mean=_safe_float(
                            posterior.get("mean"),
                            self.priors["mean"],
                        ),
                        variance=max(
                            _safe_float(
                                posterior.get("variance"),
                                self.priors["variance"],
                            ),
                            1e-9,
                        ),
                        effective_samples=max(
                            _safe_float(
                                posterior.get("effective_samples"),
                                0.0,
                            ),
                            0.0,
                        ),
                        win_rate=max(
                            0.0,
                            min(
                                1.0,
                                _safe_float(
                                    posterior.get("win_rate"),
                                    0.0,
                                ),
                            ),
                        ),
                        average_r=_safe_float(
                            posterior.get("average_r"),
                            0.0,
                        ),
                        last_update=_safe_float(
                            posterior.get("last_update"),
                            _now_ts(),
                        ),
                    )
                    loaded += 1
                except Exception:
                    logger.warning(
                        "Ignoring invalid MetaLearner posterior: %s",
                        key,
                    )

            if loaded:
                logger.info(
                    "Loaded %d Bayesian MetaLearner posterior(s) from ChromaDB",
                    loaded,
                )
        except Exception as exc:
            logger.warning(
                "Could not load MetaLearner posterior state: %s",
                exc,
            )

    def _persist_one(
        self,
        key: str,
        posterior: _Posterior,
    ) -> None:
        document = self._serialize(key, posterior)

        self.collection.upsert(
            ids=[key],
            metadatas=[
                {
                    "schema_version": SCHEMA_VERSION,
                    "key": key,
                    "posterior": json.dumps(
                        document["posterior"],
                        sort_keys=True,
                    ),
                    "updated_at": document["updated_at"],
                }
            ],
            documents=[json.dumps(document, sort_keys=True)],
        )

    # ------------------------------------------------------------------
    # Bayesian update
    # ------------------------------------------------------------------

    def _get_or_create_posterior(
        self,
        context: LearnerContext,
        strategy: str,
    ) -> _Posterior:
        key = self._key(context, strategy)

        posterior = self.posteriors.get(key)
        if posterior is None:
            prior = self.priors
            posterior = _Posterior(
                mean=prior["mean"],
                variance=prior["variance"],
                effective_samples=0.0,
                win_rate=0.0,
                average_r=0.0,
                last_update=_now_ts(),
            )
            self.posteriors[key] = posterior

        return posterior

    def _apply_decay(self, posterior: _Posterior, now: Optional[float] = None):
        if not self.decay_enabled:
            return

        now = _now_ts() if now is None else now
        elapsed_hours = max(
            0.0,
            (now - posterior.last_update) / 3600.0,
        )

        if elapsed_hours <= 0.0:
            return

        factor = math.pow(
            0.5,
            elapsed_hours / self.half_life_hours,
        )

        posterior.effective_samples *= factor
        posterior.last_update = now

    def observe(
        self,
        *,
        strategy_name: str,
        pnl_pct: float,
        risk_multiple: float = 0.0,
        context: Optional[LearnerContext] = None,
        verified_fill: bool = True,
        timestamp_utc: Optional[float] = None,
    ) -> Dict[str, Any]:
        """Observe one verified trade outcome.

        This method only updates learner state. It never executes orders.
        """
        if not verified_fill:
            raise ValueError(
                "MetaLearner refuses to learn from an unverified fill"
            )

        strategy_name = str(strategy_name or "").strip()
        if not strategy_name:
            raise ValueError("strategy_name is required")

        context = context or LearnerContext()
        pnl_pct = _safe_float(pnl_pct)
        risk_multiple = _safe_float(risk_multiple)

        with self._lock:
            posterior = self._get_or_create_posterior(
                context,
                strategy_name,
            )
            self._apply_decay(posterior, timestamp_utc)

            prior_mean = posterior.mean
            prior_n = posterior.effective_samples

            # Bounded observation prevents a single abnormal fill from
            # dominating the posterior.
            observation = max(-10.0, min(10.0, pnl_pct))

            new_n = prior_n + 1.0
            alpha = 1.0 / new_n

            delta = observation - prior_mean
            posterior.mean = prior_mean + alpha * delta

            # Stable online variance estimate.
            if new_n > 1.0:
                posterior.variance = max(
                    1e-9,
                    (
                        posterior.variance * max(prior_n - 1.0, 0.0)
                        + delta * (observation - posterior.mean)
                    )
                    / max(new_n - 1.0, 1.0),
                )

            win = 1.0 if pnl_pct > 0.0 else 0.0
            posterior.win_rate += (win - posterior.win_rate) / new_n
            posterior.average_r += (
                risk_multiple - posterior.average_r
            ) / new_n
            posterior.effective_samples = new_n
            posterior.last_update = (
                _now_ts() if timestamp_utc is None else timestamp_utc
            )

            key = self._key(context, strategy_name)
            self._persist_one(key, posterior)

            result = {
                "strategy": strategy_name,
                "regime": context.regime,
                "asset_bucket": context.asset_bucket,
                "horizon": context.horizon,
                "mean_net_edge": posterior.mean,
                "variance": posterior.variance,
                "uncertainty": math.sqrt(posterior.variance),
                "effective_samples": posterior.effective_samples,
                "win_rate": posterior.win_rate,
                "average_r": posterior.average_r,
            }

            logger.info(
                "🧠 MBIO LEARNING: %s | %s/%s | PnL=%+.2f%% | "
                "samples=%.1f | edge=%+.4f | uncertainty=%.4f | %s",
                strategy_name,
                context.regime,
                context.horizon,
                pnl_pct,
                posterior.effective_samples,
                posterior.mean,
                math.sqrt(posterior.variance),
                "WIN" if pnl_pct > 0 else "LOSS",
            )

            return result

    # ------------------------------------------------------------------
    # Existing MBIO compatibility API
    # ------------------------------------------------------------------

    def update(
        self,
        regime: str,
        strategy_name: str,
        pnl_pct: float,
        learning_rate: float = 0.05,
    ):
        """Compatibility adapter for the existing MBIO close-trade path.

        learning_rate is intentionally ignored. The upgraded Bayesian
        learner owns its update math.
        """
        del learning_rate

        result = self.observe(
            strategy_name=strategy_name,
            pnl_pct=pnl_pct,
            context=LearnerContext(
                regime=str(regime or "RANGING"),
                asset_bucket=COMPAT_ASSET_BUCKET,
                horizon=COMPAT_HORIZON,
            ),
            verified_fill=True,
        )

        logger.info(
            "💾 MBIO CHROMA: %s | %s | rating=%.4f | samples=%.1f",
            strategy_name,
            regime,
            result["mean_net_edge"],
            result["effective_samples"],
        )

        return result

    def record_trade_outcome(
        self,
        strategy_name: str,
        regime: str,
        pnl_pct: float,
    ):
        """Existing MBIO API retained as a compatibility adapter."""
        return self.update(regime, strategy_name, pnl_pct)

    # ------------------------------------------------------------------
    # Weight calculation
    # ------------------------------------------------------------------

    def _strategy_posteriors(
        self,
        context: LearnerContext,
        strategies: List[str],
    ) -> Dict[str, _Posterior]:
        return {
            strategy: self._get_or_create_posterior(
                context,
                strategy,
            )
            for strategy in strategies
        }

    def get_strategy_weights(
        self,
        context: LearnerContext,
        strategies: Optional[List[str]] = None,
    ) -> StrategyWeights:
        """Return uncertainty-discounted softmax strategy weights."""
        strategies = list(strategies or [])

        if not strategies:
            with self._lock:
                keys = []
                prefix = json.dumps(
                    {
                        "regime": context.regime,
                        "asset_bucket": context.asset_bucket,
                        "horizon": context.horizon,
                    },
                    sort_keys=True,
                    separators=(",", ":"),
                )[:-1]

                for key in self.posteriors:
                    if prefix in key:
                        try:
                            payload = json.loads(key)
                            keys.append(payload["strategy"])
                        except Exception:
                            continue

                strategies = sorted(set(keys))

        if not strategies:
            return StrategyWeights({}, {}, {}, {})

        with self._lock:
            posteriors = self._strategy_posteriors(
                context,
                strategies,
            )

            scores: Dict[str, float] = {}
            uncertainty: Dict[str, float] = {}
            samples: Dict[str, float] = {}
            reasons: Dict[str, str] = {}

            for strategy, posterior in posteriors.items():
                self._apply_decay(posterior)

                sigma = math.sqrt(max(posterior.variance, 1e-9))
                uncertainty[strategy] = sigma
                samples[strategy] = posterior.effective_samples

                if posterior.effective_samples < self.min_effective_samples:
                    scores[strategy] = 0.0
                    reasons[strategy] = "INSUFFICIENT_EVIDENCE"
                    continue

                scores[strategy] = (
                    posterior.mean
                    / (
                        1.0
                        + self.uncertainty_aversion * sigma
                    )
                )
                reasons[strategy] = "SUFFICIENT_EVIDENCE"

            eligible = [
                strategy
                for strategy in strategies
                if scores.get(strategy, 0.0) != 0.0
            ]

            if not eligible:
                return StrategyWeights(
                    weights={strategy: 0.0 for strategy in strategies},
                    uncertainty=uncertainty,
                    effective_samples=samples,
                    reason_codes=reasons,
                )

            max_score = max(scores[s] for s in eligible)

            raw: Dict[str, float] = {}
            denominator = 0.0

            for strategy in eligible:
                value = math.exp(
                    (scores[strategy] - max_score)
                    / self.temperature
                )
                raw[strategy] = value
                denominator += value

            if denominator <= 0.0:
                return StrategyWeights(
                    weights={strategy: 0.0 for strategy in strategies},
                    uncertainty=uncertainty,
                    effective_samples=samples,
                    reason_codes=reasons,
                )

            weights = {
                strategy: (
                    raw.get(strategy, 0.0) / denominator
                )
                for strategy in strategies
            }

            # Apply configured caps as final hard limits.
            #
            # Do NOT renormalize after applying caps. Renormalization would
            # increase a capped strategy above its configured risk ceiling.
            # Any unallocated remainder is intentionally left at zero risk.
            for strategy in list(weights):
                cap = (
                    self.max_llm_weight
                    if strategy.upper() == "LLM"
                    else self.max_strategy_weight
                )
                weights[strategy] = min(
                    max(weights[strategy], 0.0),
                    cap,
                )

            return StrategyWeights(
                weights=weights,
                uncertainty=uncertainty,
                effective_samples=samples,
                reason_codes=reasons,
            )

    def get_weights(self, regime: str) -> Dict[str, float]:
        """Existing API used by MBIO position management.

        Returns only sufficiently evidenced Bayesian weights.
        """
        result = self.get_strategy_weights(
            LearnerContext(
                regime=str(regime or "RANGING"),
                asset_bucket=COMPAT_ASSET_BUCKET,
                horizon=COMPAT_HORIZON,
            )
        )
        return dict(result.weights)

    def choose_strategy(
        self,
        regime: str,
        strategies: List[str],
    ) -> str:
        """Deterministic best-evidence choice.

        Exploration remains outside the learner. The learner does not
        randomly place or route orders.
        """
        if not strategies:
            return "LLM"

        weights = self.get_weights(regime)

        if not weights:
            return strategies[0]

        return max(
            strategies,
            key=lambda strategy: weights.get(strategy, 0.0),
        )

    def get_best_strategy(self, regime: str) -> str:
        weights = self.get_weights(regime)
        if not weights:
            return "LLM"
        return max(weights, key=weights.get)

    # ------------------------------------------------------------------
    # State / compatibility
    # ------------------------------------------------------------------

    def snapshot_state(self) -> LearnerStateSnapshot:
        with self._lock:
            contexts = len(
                {
                    key.rsplit('"strategy":', 1)[0]
                    for key in self.posteriors
                }
            )
            return LearnerStateSnapshot(
                version=SCHEMA_VERSION,
                posterior_count=len(self.posteriors),
                contexts=contexts,
                updated_at=_utc_now(),
            )

    def reset_state(self, scope: Optional[str] = None) -> None:
        """Reset posterior state.

        This only changes learner state and never execution state.
        """
        with self._lock:
            if scope is None:
                self.posteriors.clear()
                existing = self.collection.get()
                ids = existing.get("ids") or []
                if ids:
                    self.collection.delete(ids=ids)
                logger.info("MetaLearner state reset")
                return

            to_delete = []
            for key in self.posteriors:
                try:
                    payload = json.loads(key)
                    if (
                        payload.get("regime") == scope
                        or payload.get("asset_bucket") == scope
                        or payload.get("horizon") == scope
                    ):
                        to_delete.append(key)
                except Exception:
                    continue

            for key in to_delete:
                self.posteriors.pop(key, None)

            if to_delete:
                self.collection.delete(ids=to_delete)

            logger.info(
                "MetaLearner scope reset: %s (%d posterior(s))",
                scope,
                len(to_delete),
            )

    def reset_regime_to_default(self, regime: str):
        """Compatibility method.

        No static DEFAULT_WEIGHTS are restored. Reset means remove learned
        evidence for that regime so the configured prior becomes active.
        """
        self.reset_state(regime)


_meta_learner_instance: Optional[MetaLearner] = None
_meta_learner_lock = threading.Lock()


def get_meta_learner() -> MetaLearner:
    global _meta_learner_instance

    with _meta_learner_lock:
        if _meta_learner_instance is None:
            _meta_learner_instance = MetaLearner()

        return _meta_learner_instance
